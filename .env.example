# Local MariaDB/MySQL (port 3306) or Docker Compose MariaDB (port 3307)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=merayau
DB_PASSWORD=merayau_dev
DB_NAME=merayau_outdoor

# Production TiDB Cloud example (set in Vercel Environment Variables):
# DATABASE_URL=mysql://USER:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/merayau_outdoor
DATABASE_URL=mysql://merayau:merayau_dev@127.0.0.1:3307/merayau_outdoor
DB_SSL=false

# Session signing secret (generate long random hex in production)
AUTH_SECRET=change-this-to-a-long-random-secret

# Vercel Blob token for persistent admin media uploads (auto-injected when connected on Vercel)
BLOB_READ_WRITE_TOKEN=

ADMIN_SEED_EMAIL=admin@merayau.id
ADMIN_SEED_PASSWORD=change-me

# Google AI Studio Gemini API (for Merayau Adventure chatbot)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
