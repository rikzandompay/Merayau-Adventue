# Local MariaDB/MySQL (port 3306) or Docker Compose MariaDB (port 3307)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=merayau
DB_PASSWORD=merayau_dev
DB_NAME=merayau_outdoor

# Production TiDB Cloud example (set in Vercel Environment Variables):
# DATABASE_URL=mysql://USER:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/merayau_outdoor
DATABASE_URL=mysql://merayau:merayau_dev@127.0.0.1:3307/merayau_outdoor
DB_SSL=false

# Session signing secret (REQUIRED in production: min 32 random chars, e.g. `openssl rand -hex 32`)
AUTH_SECRET=

# Vercel Blob token for persistent admin media uploads (auto-injected when connected on Vercel)
BLOB_READ_WRITE_TOKEN=

# Initial admin seed credentials (password min 12 chars in production)
ADMIN_SEED_EMAIL=admin@merayau.id
ADMIN_SEED_PASSWORD=

# Optional dedicated public contact email (separates public footer email from admin login email)
PUBLIC_CONTACT_EMAIL=halo@merayau.id

# Optional webhook URL (Slack / Discord / Telegram proxy / n8n) for security alerts
SECURITY_ALERT_WEBHOOK_URL=

# Google AI Studio Gemini API (for Merayau Adventure chatbot)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
